_site
.sass-cache
Gemfile.lock
*.gem
.DS_Store
.jekyll-cache
git-update.sh
# 源笔记目录不入库（public/ 公开、hidden/ 不在主页显示）。
# 用 origin/* 而不是 origin/，是为了让 origin/.gitignore 本身能被跟踪，
# 这样忽略规则随目录结构一起进仓库，换机器 clone 也不会误提交源文件。
origin/*
!origin/.gitignore
__pycache__/
*.pyc

# 官方图标包本地缓存（体积大，不入库）
_icon-src/

# 备份文件（网页不用，本地保留）
*.bak

# 会话附件（截图等，网页不用）
.reasonix/

# 笔记重构前的原始备份（本地保留，不入库）
origin_backup/
